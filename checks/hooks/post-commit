#!/bin/sh
# Purpose: ViD post-commit hook — the amendment record (v0.9.3 spec 3.7, R10).
# A verdict judges the row as it read: under an inventory block whose first
# fence line is `grammar: 0.9.3`, after every commit this appends
# `amended row=ID sha=<HEAD>` to .vid/metrics-events for (a) every ROW line
# whose obligation column changed between HEAD~1 and HEAD in INVENTORY.md,
# and (b) every ROW derived from a REQ whose EFFECTIVE fail-if text differs
# between the two trees (checks/prd.sh --failifs: the vid-prd effective set,
# or a legacy PRD's `### REQ-NNN` block's Fail-if line). checks/metrics.sh
# reads the event as a wipe: the row is unverdicted, its attempt history
# restarts, and a verdict quoted before this commit is ineligible. Post-
# commit, because the sha does not exist at pre-commit time and a commit
# refused by pre-commit's later steps or by commit-msg must record nothing.
# A consolidation commit records none — its effective text is unchanged; a
# new row, and an AMENDED item whose fail-if did not change, record none.
# Never blocks (a post-commit hook cannot); silent when nothing changed.
# Installed with the other hooks (core.hooksPath checks/hooks).
# v0.9.6 (3.6, R6): under the gate (`sh checks/plan.sh gate` on) the events
# go to the run's home — the worktree holding RUN-STATE, named by a builder
# worktree's .vid/home — so a row amended in a builder worktree is seen by
# the home's currency check. Outside it, to this worktree's .vid/, as before.
# v0.9.8 (3.3, R6): each event names its cause — `by=obligation` (the row's own obligation changed) or `by=fail-if`
# (an item it derives from changed its fail-if). Only the row's own amendment clears its authority flag
# (checks/brief.sh authority); the wipe is unchanged.
set -u
IFS='
'
git rev-parse -q --verify HEAD~1 >/dev/null 2>&1 || exit 0
blk() { git show "$1:INVENTORY.md" 2>/dev/null | sed -n '/^```vid-inventory/,/^```$/p' | sed '1d;$d'; }
NEW=$(blk HEAD)
case "$(printf '%s\n' "$NEW" | grep -v '^[[:space:]]*$' | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')" in 'grammar: 0.9.3') ;; *) exit 0 ;; esac
SHA=$(git rev-parse --short=12 HEAD)
T=$(mktemp -d) || exit 0
trap 'rm -rf "$T"' EXIT
blk HEAD~1 | grep -E '^[[:space:]]*ROW-' > "$T/old" || true
printf '%s\n' "$NEW" | grep -E '^[[:space:]]*ROW-' > "$T/new" || true
: > "$T/reqs"
if [ -f checks/prd.sh ]; then
  git show HEAD~1:PRD.md > "$T/prd.old" 2>/dev/null || : > "$T/prd.old"
  git show HEAD:PRD.md > "$T/prd.new" 2>/dev/null || : > "$T/prd.new"
  sh checks/prd.sh --failifs "$T/prd.old" > "$T/f.old" 2>/dev/null || : > "$T/f.old"
  sh checks/prd.sh --failifs "$T/prd.new" > "$T/f.new" 2>/dev/null || : > "$T/f.new"
  awk -F'\t' 'NR==FNR { o[$1]=$2; next } ($1 in o) && o[$1]!=$2 { print $1 }' "$T/f.old" "$T/f.new" > "$T/reqs"
fi
awk -F'|' -v of="$T/old" -v rf="$T/reqs" '
  function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
  BEGIN { while ((getline l < of) > 0) { split(l, a, "|"); ob[trim(a[1])]=trim(a[6]) } while ((getline l < rf) > 0) chg[l]=1 }
  { id=trim($1); why=""
    if ((id in ob) && ob[id]!=trim($6)) why="obligation"
    n=split(trim($7), t, /[ ,]+/); for (k=1;k<=n;k++) if (t[k] in chg) { why=why (why==""?"":"+") "fail-if " t[k]; break }
    if (why!="" && !(id in done)) { print id "\t" (why ~ /^obligation/ ? "obligation" : "fail-if"); done[id]=1 } }' "$T/new" > "$T/amended"
N=$(grep -c . "$T/amended" || true)
[ "$N" -gt 0 ] || exit 0
EVD=.vid
if [ -f checks/plan.sh ]; then
  _g=$(sh checks/plan.sh gate 2>/dev/null || true)
  case "$_g" in 'on '*) EVD="${_g#on }/.vid" ;; esac
fi
mkdir -p "$EVD"
AT=$(date -u '+%Y-%m-%dT%H:%M:%SZ')   # v0.9.5 3.11: every event line ends ` at=<UTC>`
while IFS='	' read -r id by; do printf 'amended row=%s sha=%s by=%s at=%s\n' "$id" "$SHA" "$by" "$AT" >> "$EVD/metrics-events"; done < "$T/amended"
echo "ViD post-commit: $N row(s) amended at $SHA — their verdicts are wiped and they return to the next claim; a verdict quoted before this commit is ineligible (v0.9.3 3.7): $(cut -f1 "$T/amended" | tr '\n' ' ')"
exit 0
