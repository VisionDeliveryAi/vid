#!/bin/sh
# Purpose: ViD court — protected paths (ledger/checks/design), the law-change
# standalone rule (§4.1: a commit touching law may touch nothing else),
# Purpose: headers on new source files, enforcement refs on DECISIONS entries,
# then placement, conformance and the presence-gated courts including the
# census and the provider-seam court; Fail-if amendments counted (§10).
# Fails closed. Law: CLAUDE.md; rule-source list: checks/lawfiles.
# Installed via core.hooksPath.
# v0.9.5 (3.7-3.9; R7-R9): the hook times what it runs, into its own file,
# one line per commit attempt (refused ones included) —
#   hook result=pass|refused|killed seconds=<total> placement=<s> conformance=<s> imports=<s> seams=<s> inventory+census=<s> design-cite=<s> prd=<s|memo|-> harness=<s> selftest=<s|memo|-> redstamp=<s|-> at=<UTC>
# in .vid/hook-times, every field `-` until its court runs, written by the
# EXIT trap whatever the exit path, never able to turn a pass into a refusal
# (`result=pass` is this hook's; commit-msg can still refuse the commit); the
# courts run side by side — the quick gate (placement, conformance, imports,
# seams) together, then the lanes (inventory then census, design-cite, prd,
# harness) together — each job's output, status and seconds in its own file,
# replayed in a fixed order, every failing court named, exactly the commits
# the serial hook refused refused; and two memos skip work whose inputs are
# unchanged on disk — the PRD court, and the law commit's run of ViD's
# shipped self-test cases — only once rule 2a has run (HEAD carries checks/).
# v0.9.6.2 (3.4, R4): every refusal is named. Each refusing exit sets BY —
# the courts that run side by side from the FAILED list (several failing
# together are all named, comma-separated; inventory and census apart),
# every other refusal its own name at its own exit (protected-paths,
# law-dirty, law-standalone, purpose-header, decisions-enforced,
# decisions-promissory, decisions-label (v0.9.7.3), hosting-access (v0.26.10.8), index-copy, red-stamp, prd-grammar, selftest) — and
# the EXIT trap, on a refused exit, appends ` by=<names>` to its hook-times
# line and writes `refused phase=pre-commit by=<names> attempt=<UTC time
# plus 4 hex>` to the run's events (checks/event.sh, so at the run's home).
# The order in which the courts run does not change.
# v0.9.7.3 (3.5, R5): a refused attempt also leaves its record at the run's
# home, .vid/refusals/<attempt>/ (meta, and each refusing court's output), and
# a `court-refused court= rule= subject= tree= attempt=` event per court.
# v0.9.7.0.11 (3.14, R14): the hook-times line goes to the run's home, found as
# checks/event.sh finds it (checks/plan.sh home-of), carrying
# `checkout=<basename of this toplevel>` when the commit is in another
# checkout (a builder's worktree); at the home itself, or with no live
# run, it stays this checkout's .vid/hook-times line, as before.
set -eu
IFS='
'

# --- v0.9.5 (3.7): the timing line, written on every exit path ---------------------
T0=$(date +%s); RESULT=''; TD=''; JOBS=''; BY=''
F_placement=-; F_conformance=-; F_imports=-; F_seams=-; F_invcen=-; F_designcite=-; F_prd=-; F_harness=-; F_selftest=-; F_redstamp=-
hook_times() {
  rc=$1; set +e
  [ -n "$RESULT" ] || { if [ "$rc" -eq 0 ]; then RESULT=pass; else RESULT=refused; fi; }
  _byf=''; [ "$RESULT" = refused ] && _byf=" by=${BY:-unknown}"
  # v0.9.7.0.11 (3.14, R14): at the run's home, resolved as checks/event.sh resolves it (plan.sh home-of), with
  # checkout=<this toplevel's basename> when that is another checkout; with no live run, the local .vid/, as before
  _htd=.vid; _pl="$(dirname "$0")/../plan.sh"
  if [ -f "$_pl" ]; then
    _ph=$(sh "$_pl" home-of 2>/dev/null) || _ph=''; _tp=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
    if [ -n "$_ph" ] && [ -d "$_ph/.vid" ] && [ "$(cd "$_ph" && pwd -P)" != "$(cd "$_tp" && pwd -P)" ]; then _htd="$_ph/.vid"; _byf="$_byf checkout=$(basename "$_tp")"; fi
  fi
  { mkdir -p "$_htd" && printf 'hook result=%s seconds=%s placement=%s conformance=%s imports=%s seams=%s inventory+census=%s design-cite=%s prd=%s harness=%s selftest=%s redstamp=%s%s at=%s\n' \
      "$RESULT" "$(( $(date +%s) - T0 ))" "$F_placement" "$F_conformance" "$F_imports" "$F_seams" "$F_invcen" "$F_designcite" "$F_prd" "$F_harness" "$F_selftest" "$F_redstamp" "$_byf" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$_htd/hook-times"; } 2>/dev/null
  if [ "$RESULT" = refused ]; then
    _nonce() { printf '%s-%s' "$(date -u '+%Y%m%dT%H%M%SZ')" "$(od -An -N2 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"; }
    _att=$(_nonce)
    # v0.9.7.3 (3.5, R5): the refusal's record at the run's home, per attempt, before the cleanup —
    # <home>/.vid/refusals/<attempt>/meta (tree= the index's tree, head=, a `court= rule= subject=` line per court) and each refusing
    # court's <court>.out and .err; rule and subject from the court's own machine lines (census `FAIL  <rule>
    # <subject>`, inventory `GAP  <subject>` as rule gap), else `-`. A refusal before the courts names itself as
    # the court and keeps no output (it printed its reason). One `court-refused` event per court.
    _evh="$(dirname "$0")/../event.sh"
    _rfd="$_htd/refusals"; mkdir -p "$_rfd" 2>/dev/null
    _i=0; while ! mkdir "$_rfd/$_att" 2>/dev/null && [ "$_i" -lt 20 ]; do _i=$((_i + 1)); _att=$(_nonce)-$_i; done
    _tree=$(git write-tree 2>/dev/null || echo -); _head=$(git rev-parse -q --verify HEAD 2>/dev/null || echo -)
    if [ -f "$_evh" ]; then sh "$_evh" "refused phase=pre-commit by=${BY:-unknown} attempt=$_att" 2>/dev/null
    else { mkdir -p .vid && printf 'refused phase=pre-commit by=%s attempt=%s at=%s\n' "${BY:-unknown}" "$_att" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> .vid/metrics-events; } 2>/dev/null; fi
    printf 'tree=%s\nhead=%s\n' "$_tree" "$_head" > "$_rfd/$_att/meta" 2>/dev/null
    for _c in $(printf '%s\n' "${BY:-unknown}" | tr ',' '\n'); do
      _r=-; _sj=-
      if [ -n "$TD" ] && [ -f "$TD/$_c.st" ]; then
        cp "$TD/$_c.out" "$_rfd/$_att/$_c.out" 2>/dev/null; cp "$TD/$_c.err" "$_rfd/$_att/$_c.err" 2>/dev/null
        _ml=$(cat "$TD/$_c.out" "$TD/$_c.err" 2>/dev/null | awk -v c="$_c" 'c == "census" && $1 == "FAIL" && NF >= 3 { print $2 " " $3; exit } c == "inventory" && $1 == "GAP" && NF >= 2 { print "gap " $2; exit }')
        [ -n "$_ml" ] && { _r=${_ml%% *}; _sj=${_ml#* }; }
      fi
      printf 'court=%s rule=%s subject=%s\n' "$_c" "$_r" "$_sj" >> "$_rfd/$_att/meta" 2>/dev/null
      if [ -f "$_evh" ]; then sh "$_evh" "court-refused court=$_c rule=$_r subject=$_sj tree=$_tree attempt=$_att" 2>/dev/null
      else { mkdir -p .vid && printf 'court-refused court=%s rule=%s subject=%s tree=%s attempt=%s at=%s\n' "$_c" "$_r" "$_sj" "$_tree" "$_att" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> .vid/metrics-events; } 2>/dev/null; fi
    done
  fi
  [ -n "$TD" ] && rm -rf "$TD" 2>/dev/null
  return 0
}
kill_tree() { for _c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$_c"; done; kill "$1" 2>/dev/null; }
on_kill() { set +e; RESULT=killed; for _p in $JOBS; do kill_tree "$_p"; done; exit 143; }
trap 'rc=$?; hook_times "$rc"; exit $rc' EXIT
trap on_kill INT TERM

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$STAGED_ALL" ] || exit 0

# v0.9.3 (3.9, R13, R22): a nudge the observer left is printed at every
# commit and never blocks; the session answers it with
# `sh checks/watchdog.sh claim run --evidence '<observation>'`.
if [ -f .vid/NUDGE ]; then
  case "$(git show :INVENTORY.md 2>/dev/null | sed -n '/^```vid-inventory/,/^```$/p' | sed '1d;$d' | grep -v '^[[:space:]]*$' | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')" in
    'grammar: 0.9.3') echo "ViD pre-commit: note — the observer left a nudge: $(head -n 1 .vid/NUDGE). Answer it with an observation: sh checks/watchdog.sh claim run --evidence '<what you observed>'" ;;
  esac
fi

# v0.26.10.4 (R11, F-44): while a merge is in progress (MERGE_HEAD), JUDGED is what the merge itself adds — the staged
# paths whose content differs from both parents: a conflict resolution or an edit; a path one parent already holds
# as staged is that parent's, judged when it was committed. Else JUDGED is every staged path. Rules 1 and 2 judge
# JUDGED (the 2026-10-19 spec correction: the law-standalone rule too); every other court runs as for any commit.
JUDGED=$STAGED_ALL
if _mh=$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null); then
  _ob() { git rev-parse -q --verify "$1" 2>/dev/null || echo none; }
  JUDGED=$(for _f in $STAGED_ALL; do _s=$(_ob ":$_f"); [ "$_s" = "$(_ob "HEAD:$_f")" ] || [ "$_s" = "$(_ob "$_mh:$_f")" ] || printf '%s\n' "$_f"; done)
fi

# 1. Ledger and courts are outside ordinary write scope (CLAUDE.md ledger law).
if [ "${VID_ROLE:-}" != "fix" ]; then
  PROT=$(printf '%s\n' "$JUDGED" | grep -E '^(tests/invariants/|checks/|design/)' || true)
  if [ -n "$PROT" ]; then
    echo 'ViD pre-commit: rejected — protected paths staged without VID_ROLE=fix:' >&2
    printf '%s\n' "$PROT" | sed 's/^/    /' >&2
    echo 'Only owner-sanctioned writes may touch tests/invariants/, checks/ or design/.' >&2
    BY=protected-paths; exit 1
  fi
fi

# 2. Law-change standalone rule (§4.1): a commit that touches any vid-*
#    machine block, any file in checks/, or that deletes/weakens a ledger
#    assertion, may touch nothing else. Additions to the ledger stay free —
#    the dual-write depends on it. Skipped while HEAD carries no checks/
#    (the commit that installs the courts is the ratification act itself;
#    since v0.8.1b the PRD's ratification commits precede it as the
#    project's first history, so "root commit" is no longer the test).
#    Rule sources are enumerated once, in checks/lawfiles.
LAWCOMMIT=no
MEMO_OK=no
if git rev-parse -q --verify HEAD:checks >/dev/null 2>&1; then
  # 2a. The courts judge with the WORKING TREE. Law sources carrying
  #     unstaged or untracked changes would let this commit be judged by law
  #     that is never committed (F12, made invisible) — refuse to proceed.
  set -- checks design DESIGN-BRIEF.md
  if [ -f checks/lawfiles ]; then
    for lf in $(grep -v '^#' checks/lawfiles | grep -v '^[[:space:]]*$' || true); do
      set -- "$@" "${lf%% *}"
    done
  fi
  LAWDIRTY=$(git diff --name-only -- "$@" 2>/dev/null || true)
  LAWNEW=$(git ls-files --others --exclude-standard -- checks/ design/ 2>/dev/null || true)
  if [ -n "$LAWDIRTY$LAWNEW" ]; then
    # v0.9.8.1 (R3, F-13): the same refusal, its message naming the files and the two ways through
    echo 'ViD pre-commit: rejected — law files are edited but not staged (unstaged/untracked law):' >&2
    printf '%s\n%s\n' "$LAWDIRTY" "$LAWNEW" | grep -v '^$' | sort -u | sed 's/^/    /' >&2
    echo 'The courts run from the working tree, so they would judge this commit by law it does not carry. Do one of these, then commit again:' >&2
    echo '  - commit those files first, as their own law commit;' >&2
    echo '  - or set them aside with a WIP commit (on a side branch, never a stash) and bring them back after this commit.' >&2
    BY=law-dirty; exit 1
  fi
  MEMO_OK=yes   # v0.9.5 (3.9): disk equals the index under checks/ from here — the memos may be read and written

  extract() { # $1=git blob ref ($1 may not exist: empty) $2=region name
    C=$(git show "$1" 2>/dev/null || true)
    case "$2" in
      seam-table) printf '%s\n' "$C" | grep -E '^\||^Import court:' || true ;;
      whole) printf '%s\n' "$C" ;;   # v0.9.3 3.3: the whole file is the region
      *) printf '%s\n' "$C" | sed -n '/^```'"$2"'/,/^```$/p' || true ;;
    esac
  }
  TRIGGERS=''
  # (a) any staged change under checks/
  if printf '%s\n' "$JUDGED" | grep -q '^checks/'; then
    TRIGGERS="${TRIGGERS}checks/ (the courts and their harness)
"
  fi
  # (b) any staged change to a machine-read rule-source region
  if [ -f checks/lawfiles ]; then
    for lf in $(grep -v '^#' checks/lawfiles | grep -v '^[[:space:]]*$' || true); do
      f=${lf%% *}; reg=${lf#* }
      printf '%s\n' "$JUDGED" | grep -qxF "$f" || continue
      if [ "$(extract "HEAD:$f" "$reg")" != "$(extract ":$f" "$reg")" ]; then
        TRIGGERS="${TRIGGERS}$f ($reg)
"
      fi
    done
  fi
  # (c) deletions/weakenings in the ledger: removed assert lines or removed
  #     test functions in the staged diff (additions do not trigger).
  # v0.26.10.4 (R11): the ledger paths judged (all of tests/invariants/ outside a merge)
  JLEDGER=tests/invariants/; [ -n "${_mh:-}" ] && JLEDGER=$(printf '%s\n' "$JUDGED" | grep '^tests/invariants/' || true)
  KILLS=0; [ -n "$JLEDGER" ] && KILLS=$(git diff --cached -U0 -- $JLEDGER 2>/dev/null | grep -E '^-' | grep -v '^---' \
    | grep -cE '\bassert\b|\bexpect\(|def test_|\bit\(|\btest\(' || true)
  if [ "${KILLS:-0}" -gt 0 ]; then
    TRIGGERS="${TRIGGERS}tests/invariants/ ($KILLS removed assertion/test line(s) — deleting or weakening is a law change; adding is free)
"
  fi
  # (c2) neutering by ADDITION: an added skip/xfail marker over a row-bound
  #      test has the same effect as deleting its assertions — same law.
  SKIPS=0; [ -n "$JLEDGER" ] && SKIPS=$(git diff --cached -U0 -- $JLEDGER 2>/dev/null | grep '^+' | grep -v '^+++' \
    | grep -cE '@[A-Za-z_.]*skip|\bskipif\b|\bxfail\b|\bskipTest\b|\.skip\(|\bpytest\.skip\b' || true)
  if [ "${SKIPS:-0}" -gt 0 ]; then
    TRIGGERS="${TRIGGERS}tests/invariants/ ($SKIPS added skip/xfail marker(s) — neutering by addition is a law change)
"
  fi
  # (d) the ratified design changes only as a visible, standalone act:
  #     modifications/deletions under design/ are law changes; additions
  #     stay free (the ratification import and new screens).
  DMOD=$(git diff --cached --name-only --diff-filter=MD -- design/ 2>/dev/null | while IFS= read -r _f; do printf '%s\n' "$JUDGED" | grep -qxF -- "$_f" && printf '%s\n' "$_f"; done || true)
  if [ -n "$DMOD" ]; then
    TRIGGERS="${TRIGGERS}design/ (modified/deleted — the ratified design has ledger standing)
"
  fi
  if [ -n "$TRIGGERS" ]; then
    LAWCOMMIT=yes
    NONLAW=''
    for f in $JUDGED; do
      case "$f" in checks/*|tests/invariants/*|design/*|DESIGN-BRIEF.md) continue ;; esac
      grep -v '^#' checks/lawfiles 2>/dev/null | grep -q "^$f " && continue
      NONLAW="$NONLAW$f
"
    done
    if [ -n "$NONLAW" ]; then
      echo 'ViD pre-commit: rejected — this commit changes law and must touch nothing else (§4.1).' >&2
      echo 'Law changed:' >&2
      printf '%s' "$TRIGGERS" | sed 's/^/    /' >&2
      echo 'Also staged (split these into their own commit):' >&2
      printf '%s' "$NONLAW" | sed 's/^/    /' >&2
      echo 'A law change is a standalone, owner-visible act: its Decisions: trailer states what it admits and why.' >&2
      BY=law-standalone; exit 1
    fi
  fi
fi

# 3. Every new source file declares its purpose up front.
# design/ is exempt: ratified design artifacts are imported verbatim from the
# owner — they are spec, not source (CLAUDE.md design law).
# v0.26.10.5 (amendment 1, R18): so is checks/selftest/fixtures/ — the self-test's
# test data, copied with checks/ at init (17 shipped files carry no Purpose: line).
for f in $(git diff --cached --name-only --diff-filter=A); do
  case "$f" in
    design/*|checks/selftest/fixtures/*) continue ;;
    *.md|*.yml|*.yaml|*.json|*.toml|*.ini|*.cfg|*.lock|*.txt|*.csv|*.svg|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.woff|*.woff2) continue ;;
    LICENSE*|*/LICENSE*|.*|*/.*) continue ;;
    checks/lawfiles) continue ;;
  esac
  if ! git show ":$f" | head -n 15 | grep -q 'Purpose:'; then
    echo "ViD pre-commit: rejected — new source file '$f' has no \"Purpose:\" header in its first 15 lines." >&2
    BY=purpose-header; exit 1
  fi
done

# 4. DECISIONS entries must say where they are enforced.
DLINES=$(git diff --cached -U0 -- DECISIONS.md 2>/dev/null | grep '^+- \*\*D-' || true)
# v0.9.7.3 (3.1, R1): a changed line equal to HEAD's version apart from its
# label field (applies-to: or scope:, stripped by name wherever it sits,
# since origin: and model: may follow it) is a relabel: checks 4 and 4b
# judged it when it was written, so only 4c judges it now.
unlabel() { awk -F'|' 'BEGIN { OFS = "|" } { o = ""; n = 0; for (i = 1; i <= NF; i++) { f = $i; sub(/^[ \t]+/, "", f); if (f ~ /^(applies-to|scope):/) continue; o = (n++ ? o "|" : "") $i } sub(/[ \t]+$/, "", o); print o }'; }
DHEAD=$(git show HEAD:DECISIONS.md 2>/dev/null | grep -E '^- \*\*D-[0-9]+\*\*' || true)
DJUDGE=''
for dl in $DLINES; do
  _l=${dl#+}; _id=$(printf '%s\n' "$_l" | sed -n 's/^- \*\*\(D-[0-9]*\)\*\*.*/\1/p')
  _h=$(printf '%s\n' "$DHEAD" | grep -F -- "- **$_id**" | head -n 1 || true)
  if [ -n "$_id" ] && [ -n "$_h" ] && [ "$(printf '%s\n' "$_l" | unlabel)" = "$(printf '%s\n' "$_h" | unlabel)" ]; then continue; fi
  DJUDGE="$DJUDGE$dl
"
done
BAD=$(printf '%s\n' "$DJUDGE" | grep -v '| enforced:' | grep -v '^$' || true)
if [ -n "$BAD" ]; then
  echo 'ViD pre-commit: rejected — DECISIONS.md entries without an enforcement ref:' >&2
  printf '%s\n' "$BAD" | sed 's/^/    /' >&2
  echo 'Format: - **D-NNN** <what> | why: <why> | enforced: <test/hook ref, or "convention"> | applies-to: <ids and codes>' >&2
  BY=decisions-enforced; exit 1
fi

# 4b. Enforcement refs must not be promissory: a named ledger test must exist,
# and "future/planned/TBD" is not enforcement.
for p in $(printf '%s\n' "$DJUDGE" | grep -oE 'tests/invariants/[A-Za-z0-9_./-]+' | sed 's/[.,;]*$//' | sort -u); do
  if [ ! -f "$p" ]; then
    echo "ViD pre-commit: rejected — DECISIONS.md cites '$p' as enforcement, but no such file exists." >&2
    echo 'Write the ledger test first; promissory refs are invalid.' >&2
    BY=decisions-promissory; exit 1
  fi
done
if printf '%s\n' "$DJUDGE" | grep -qiE '\| enforced:[^|]*(future|planned|TBD)'; then
  echo 'ViD pre-commit: rejected — promissory enforced: ref ("future/planned/TBD" is not enforcement).' >&2
  echo 'Write the test first, or cite a hook/convention that exists today.' >&2
  BY=decisions-promissory; exit 1
fi

# 4c. v0.9.7.3 (3.1, R1): every added or changed decision line carries a
# label — `| applies-to: <ids and codes>` or `| scope: project` — whose
# items are ones a brief can join on: INVENTORY's row ids, their
# derived-from REQ ids, its rule-row ids, the screen codes of its markers
# (the part before `/`), and the DIF ids its rows' divergence: fields name
# (a DIF label is refused when no row carries one). Read from the staged
# INVENTORY.md. Unlabelled legacy lines are not refused until they change.
# v0.26.10.2 (R17a): and the module ids of the staged ARCHITECTURE.md's
# module table — the first table with a Module column, a dotted label read
# as a path, as the viewer reads it. Nothing requires a module item.
if [ -n "$DLINES" ]; then
  DJF=$(mktemp)
  git show :INVENTORY.md 2>/dev/null | sed -n '/^```vid-inventory/,/^```$/p' | sed '1d;$d' | awk -F'|' '
    function tr(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    { id = tr($1)
      if (id ~ /^ROW-[0-9]+$/) { print id
        n = split(tr($7), a, /[ ,]+/); for (k = 1; k <= n; k++) if (a[k] ~ /^REQ-[0-9]+$/) print a[k]
        n = split(tr($5), a, /[ ,]+/); for (k = 1; k <= n; k++) if (a[k] != "n/a" && index(a[k], "/") > 1) print substr(a[k], 1, index(a[k], "/") - 1)
        for (i = 8; i <= NF; i++) { f = tr($i); if (f ~ /^divergence:/) { sub(/^divergence:[ \t]*/, "", f); n = split(f, a, /[ ,]+/); for (k = 1; k <= n; k++) if (a[k] ~ /^DIF-[0-9]+$/) print a[k] } } }
      else if (id == "rule" && tr($2) ~ /^RULE-[0-9]+$/) print tr($2) }' | sort -u > "$DJF" 2>/dev/null || : > "$DJF"
  git show :ARCHITECTURE.md 2>/dev/null | awk -F'|' 'function tr(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
      /^[ \t]*\|/ { if (done) next; if (!intab) { intab = 1; if (!col) { n = split($0, c, "|"); for (k = 2; k < n; k++) if (tr(c[k]) == "Module") col = k } next }
        if (!col || $0 ~ /^[ \t]*\|[ \t:|-]*$/) next; split($0, c, "|"); m = c[col]; gsub(/`/, "", m); m = tr(m)
        if (m == "" || index(m, "{{") == 1 || m == "Module") next; if (m !~ /\// && m ~ /\./) gsub(/\./, "/", m); print m; next }
      { if (intab && col) done = 1; intab = 0 }' >> "$DJF" 2>/dev/null || true
  LBAD=$(printf '%s\n' "$DLINES" | grep -v '^$' | awk -F'|' -v jf="$DJF" '
    function tr(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    BEGIN { while ((getline l < jf) > 0) { J[l] = 1; if (l ~ /^DIF-/) dif = 1 } }
    { line = substr($0, 2); a2 = ""; sc = ""; na = 0; ns = 0
      for (i = 2; i <= NF; i++) { f = tr($i)
        if (f ~ /^applies-to:/) { na++; sub(/^applies-to:[ \t]*/, "", f); a2 = f }
        else if (f ~ /^scope:/) { ns++; sub(/^scope:[ \t]*/, "", f); sc = f } }
      if (na + ns == 0) { print "    " line "\n      no label: add `| applies-to: <ids and codes>` or `| scope: project`"; next }
      if (na + ns > 1) { print "    " line "\n      more than one label: a decision carries one"; next }
      if (ns) { if (sc != "project") print "    " line "\n      scope: takes only `project`"; next }
      n = split(a2, it, /[ ,]+/); bad = ""; k2 = 0
      for (k = 1; k <= n; k++) { x = it[k]; if (x == "") continue; k2++
        if (x in J) continue
        if (x ~ /^DIF-[0-9]+$/ && !dif) bad = bad "\n      " x ": no INVENTORY row carries a divergence: field, so nothing could join a DIF label"
        else if (x ~ /^(ROW|REQ|RULE|DIF)-[0-9]+$/) bad = bad "\n      " x ": not an id a brief joins on (INVENTORY row ids, their derived-from REQ ids, rule-row ids, divergence: DIF ids)"
        else bad = bad "\n      " x ": not a screen code any INVENTORY row marks, nor a ROW, RULE, REQ or DIF id, nor a module id of ARCHITECTURE.md" }
      if (!k2) bad = "\n      applies-to: names nothing"
      if (bad != "") print "    " line bad }')
  rm -f "$DJF"
  if [ -n "$LBAD" ]; then
    echo 'ViD pre-commit: rejected — DECISIONS.md lines without a label a brief can join on (v0.9.7.3 R1):' >&2
    printf '%s\n' "$LBAD" >&2
    echo 'Label a decision when you write it: | applies-to: <ROW, RULE or REQ ids, screen codes, DIF ids, module ids> — or | scope: project, only when it bears on many areas.' >&2
    BY=decisions-label; exit 1
  fi
fi

# 4d. v0.26.10.8 (R4): ARCHITECTURE.md's ```vid-hosting block records access only
# by its shape, never a credential — `access:` and `dns-access:` take
# `cli-login <platform>` (the word equal to the block's `platform:`), `env
# <NAME>` (NAME matching [A-Z_][A-Z0-9_]*) or `none`. Read from the staged
# ARCHITECTURE.md; silent without the block.
HBAD=$(git show :ARCHITECTURE.md 2>/dev/null | sed -n '/^```vid-hosting[[:space:]]*$/,/^```[[:space:]]*$/p' | grep -v '^```' | awk '
  function tr(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
  { i = index($0, ":"); if (!i) next; k = tr(substr($0, 1, i - 1)); v = tr(substr($0, i + 1))
    if (k == "platform") pf = v; else if (k == "access" || k == "dns-access") { K[++n] = k; V[n] = v } }
  END { for (j = 1; j <= n; j++) { v = V[j]; m = split(v, w, /[ \t]+/)
      if (v == "none") continue
      if (m == 2 && w[1] == "env" && w[2] ~ /^[A-Z_][A-Z0-9_]*$/) continue
      if (m == 2 && w[1] == "cli-login" && w[2] == pf && pf != "") continue
      print "    " K[j] ": takes cli-login " (pf == "" ? "<platform>" : pf) ", env <NAME> or none — nothing else is recorded" } }')
if [ -n "$HBAD" ]; then
  echo "ViD pre-commit: rejected — ARCHITECTURE.md's vid-hosting block records access only by its shape (v0.26.10.8 R4):" >&2
  printf '%s\n' "$HBAD" >&2
  echo 'Never a password or a token: name the log-in (cli-login <the platform:>), or the environment variable that holds it (env <NAME>). An answer that held a value is not recorded — ask the owner for the name, and to treat the value as exposed and replace it.' >&2
  BY=hosting-access; exit 1
fi

# 5–6. The courts — placement and conformance always; the rest presence-gated,
# each on its own rule source (seam table import specifiers, INVENTORY.md,
# @screen markers, census rows/extractors), so earlier projects refresh
# checks/ without breaking. v0.9.5 (3.8, R8): side by side. No court writes a
# shared file or reads another's output (courts-events-map A10); inventory and
# census share one lane, since both run the project's routes extractor.
TD=$(mktemp -d)
# job <name> <command…>: stdout, stderr, status and seconds, each in its own file
job() { _n=$1; shift; ( set +e; _s=$(date +%s); "$@" > "$TD/$_n.out" 2> "$TD/$_n.err"; _r=$?; echo $(( $(date +%s) - _s )) > "$TD/$_n.sec"; echo "$_r" > "$TD/$_n.st" ) & JOBS="$JOBS
$!"; }
court() { : > "$TD/$1.run"; job "$@"; }
settle() { for _p in $JOBS; do [ -n "$_p" ] && { wait "$_p" || true; }; done; JOBS=''; }
sec() { cat "$TD/$1.sec" 2>/dev/null || echo -; }
FAILED=''
# replay <name>…: each court's output in the fixed order; a missing status file is a failure
replay() {
  for _n in "$@"; do
    [ -f "$TD/$_n.run" ] || continue
    [ -f "$TD/$_n.out" ] && cat "$TD/$_n.out"
    [ -f "$TD/$_n.err" ] && cat "$TD/$_n.err" >&2
    _st=$(cat "$TD/$_n.st" 2>/dev/null || true)
    [ "$_st" = 0 ] || FAILED="$FAILED $_n"
  done
}
# the quick gate: the diff-reading courts together; a refusal usually comes from them
court placement sh checks/placement.sh
court conformance sh checks/conformance.sh
if [ -f checks/imports.sh ]; then court imports sh checks/imports.sh; fi
if [ -f checks/seams.sh ]; then court seams sh checks/seams.sh; fi
# v0.26.10.5 (R4): the stage court, silent while the index holds no STAGES.md; it rides the quick gate, untimed
if [ -f checks/stages.sh ]; then court stages sh checks/stages.sh; fi
settle
F_placement=$(sec placement); F_conformance=$(sec conformance)
if [ -f "$TD/imports.run" ]; then F_imports=$(sec imports); fi
if [ -f "$TD/seams.run" ]; then F_seams=$(sec seams); fi
replay placement conformance imports seams stages
if [ -n "$FAILED" ]; then
  echo "ViD pre-commit: rejected — refused by:$FAILED" >&2
  BY=$(printf '%s' "$FAILED" | sed 's/^ *//; s/ /,/g'); exit 1
fi
# the PRD court's memo (3.9): its key is checks/ as staged, PRD.md and the seed
# file, each by the sha256 of its bytes on disk; no skip and no memo when any
# hash fails
MEMOD=''; if [ "$MEMO_OK" = yes ]; then MEMOD=$(git rev-parse --git-path vid-memo 2>/dev/null || true); fi
h256() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1; else sha256sum "$1" 2>/dev/null | cut -d' ' -f1; fi; }
hline() { _h=$(h256 "$2"); [ -n "$_h" ] || return 1; printf '%s %s\n' "$1" "$_h"; }
checks_line() { git ls-files -s -- checks > "$TD/checks.ls" 2>/dev/null || return 1; hline checks/ "$TD/checks.ls"; }
keyof() { _k=$(h256 "$1"); [ -n "$_k" ] || return 1; printf '%s\n' "$_k"; }
PRDKEY=''
if [ -n "$MEMOD" ] && [ -f checks/prd.sh ]; then
  if (   # set -e is ignored inside an if condition: every line exits on its own failure
    checks_line || exit 1
    if [ -f PRD.md ]; then hline PRD.md PRD.md || exit 1; else echo 'PRD.md -'; fi
    _sp=''; if [ -f PRD.md ]; then _sp=$(awk '/^## /{exit} /^Seed:[ \t]+[^ \t]+[ \t]+\(sha256 [0-9a-f]+\)/{print; exit}' PRD.md | sed -E 's/^Seed:[ \t]+([^ \t]+).*/\1/'); fi
    if [ -n "$_sp" ] && [ -f "$_sp" ]; then hline "$_sp" "$_sp" || exit 1; else echo "seed ${_sp:--}"; fi
  ) > "$TD/prd.key.lines" 2>/dev/null; then PRDKEY=$(keyof "$TD/prd.key.lines" || true); fi
fi
PRDSKIP=no
if [ -n "$PRDKEY" ] && [ -f "$MEMOD/prd" ] && [ "$(cat "$MEMOD/prd" 2>/dev/null)" = "$PRDKEY" ]; then PRDSKIP=yes; fi
# the lanes, started together: inventory then census in one, design-cite, prd, harness
# v0.9.6 (3.12, R12): the inventory and census lane judges the staged index.
# When the working tree differs from it — an unstaged change, or an
# untracked file that is not ignored, outside .vid/ — the lane runs in a
# copy of the index (git checkout-index), every top-level ignored entry of
# the working tree linked in (an installed environment an extractor needs),
# with GIT_DIR the repository and GIT_WORK_TREE the copy, so its git reads
# see what they see here. Nothing differing, it runs in place as before.
# Rule 2a above is unchanged: law sources still equal the index.
LANEDIR=''
if [ -f checks/inventory.sh ] || [ -f checks/census.sh ]; then
  if ! git diff --quiet -- . ':(exclude).vid' 2>/dev/null || [ -n "$(git ls-files --others --exclude-standard -- . ':(exclude).vid' 2>/dev/null | head -n 1)" ]; then
    LANEDIR="$TD/idx"
    if git checkout-index --all --prefix="$LANEDIR/" 2>/dev/null; then
      for _e in $(git ls-files --others --ignored --exclude-standard --directory 2>/dev/null | grep -E '^[^/]+/?$' || true); do
        _e=${_e%/}; [ -e "$LANEDIR/$_e" ] || ln -s "$PWD/$_e" "$LANEDIR/$_e"
      done
    else
      echo 'ViD pre-commit: rejected — the index could not be copied for the inventory and census lane.' >&2
      BY=index-copy; exit 1
    fi
  fi
fi
LANEGIT=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
if [ -f checks/inventory.sh ] || [ -f checks/census.sh ]; then
  if [ -f checks/inventory.sh ]; then : > "$TD/inventory.run"; fi
  if [ -f checks/census.sh ]; then : > "$TD/census.run"; fi
  ( set +e; _s=$(date +%s)
    if [ -n "$LANEDIR" ]; then cd "$LANEDIR" || exit 1; GIT_DIR=$LANEGIT; GIT_WORK_TREE=$LANEDIR; export GIT_DIR GIT_WORK_TREE; fi
    if [ -f checks/inventory.sh ]; then sh checks/inventory.sh > "$TD/inventory.out" 2> "$TD/inventory.err"; echo $? > "$TD/inventory.st"; fi
    if [ -f checks/census.sh ]; then sh checks/census.sh > "$TD/census.out" 2> "$TD/census.err"; echo $? > "$TD/census.st"; fi
    echo $(( $(date +%s) - _s )) > "$TD/invcen.sec" ) & JOBS="$JOBS
$!"
fi
if [ -f checks/design-cite.sh ]; then court design-cite sh checks/design-cite.sh; fi
if [ -f checks/prd.sh ]; then
  if [ "$PRDSKIP" = yes ]; then F_prd=memo; else court prd sh checks/prd.sh; fi
fi
if [ -f checks/harness.sh ]; then court harness sh checks/harness.sh; fi
settle
if [ -f "$TD/inventory.run" ] || [ -f "$TD/census.run" ]; then F_invcen=$(sec invcen); fi
if [ -f "$TD/design-cite.run" ]; then F_designcite=$(sec design-cite); fi
if [ -f "$TD/prd.run" ]; then F_prd=$(sec prd); fi
if [ -f "$TD/harness.run" ]; then F_harness=$(sec harness); fi
replay inventory census design-cite prd harness
if [ "$PRDSKIP" = yes ]; then echo 'prd: unchanged since its last pass — skipped (memo)'; fi
if [ -n "$FAILED" ]; then
  echo "ViD pre-commit: rejected — refused by:$FAILED" >&2
  BY=$(printf '%s' "$FAILED" | sed 's/^ *//; s/ /,/g'); exit 1
fi
# the PRD memo is written only after the court passed here, atomically
if [ -n "$PRDKEY" ] && [ -f "$TD/prd.run" ]; then
  { mkdir -p "$MEMOD" && printf '%s\n' "$PRDKEY" > "$MEMOD/.prd.tmp" && mv "$MEMOD/.prd.tmp" "$MEMOD/prd"; } 2>/dev/null || true
fi

# 6a. v0.9.6 (3.11, R11): the red stamp — the hook's one gated call. Inside a
# 0.9.6 develop run, a newly staged `proved-red:` stamp on a ROW row needs a
# `red-observed` event whose receipt shows that case `failed` (checks/plan.sh
# redstamp); outside it, off. Its seconds ride .vid/hook-times as redstamp=.
if [ -f checks/plan.sh ] && printf '%s\n' "$STAGED" | grep -qxF INVENTORY.md; then
  _s=$(date +%s)
  if ! sh checks/plan.sh redstamp --staged; then F_redstamp=$(( $(date +%s) - _s )); BY=red-stamp; exit 1; fi
  F_redstamp=$(( $(date +%s) - _s ))
fi

# 6b. Fail-if amendments are COUNTED, never blocked (§10, F9): an amendment
# is legitimate, but uncounted it is indistinguishable from moving the
# goalposts. Counted = added "REQ-NNN AMENDED" lines plus removed Fail-if
# lines in the staged PRD diff; the count lands in .vid/metrics-events for
# checks/metrics.sh.
# v0.9.3 (3.7, R22): under an inventory block opening with `grammar: 0.9.3`
# the removed-line grep matches the enriched grammar's `fail-if:` field too
# (the 0.9.2 grep matched `Fail-if` only — a 0.9.1 defect), and a
# consolidation commit (it adds a PRD-HISTORY-<date>.md) counts none: its
# effective text is unchanged by construction. The `amended` events are
# checks/hooks/post-commit's.
if git diff --cached --name-only | grep -qxF PRD.md; then
  # v0.9.5 (3.13): a staged grammar line lower than HEAD's is refused — the
  # one route for switching join 21 or 0.9.4's joins off; a grammar line
  # removed reads as lowered.
  gram() { git show "$1" 2>/dev/null | awk '/^## /{exit} /^grammar:[ \t]*[0-9.]+[ \t]*$/{sub(/^grammar:[ \t]*/,""); sub(/[ \t]*$/,""); print; exit}'; }
  if git rev-parse -q --verify HEAD:PRD.md >/dev/null 2>&1; then
    GH=$(gram HEAD:PRD.md); GS=$(gram :PRD.md)
    if [ -n "$GH" ] && [ "$(printf '%s\n%s\n' "${GS:-0}" "$GH" | awk -F. 'NR == 1 { for (i = 1; i <= 3; i++) a[i] = $i + 0 } NR == 2 { for (i = 1; i <= 3; i++) { b = $i + 0; if (a[i] < b) { print "lower"; exit } if (a[i] > b) { print "ok"; exit } } print "ok" }')" = lower ]; then
      echo "ViD pre-commit: rejected — PRD.md's grammar line goes from $GH to ${GS:-none}; a grammar is never lowered (v0.9.5 3.13)." >&2
      BY=prd-grammar; exit 1
    fi
  fi
  PDIFF=$(git diff --cached -U0 -- PRD.md 2>/dev/null || true)
  A1=$(printf '%s
' "$PDIFF" | grep '^+' | grep -v '^+++' | grep -cE 'REQ-[0-9]+[[:space:]]+AMENDED' || true)
  IG93=no
  case "$(git show :INVENTORY.md 2>/dev/null | sed -n '/^```vid-inventory/,/^```$/p' | sed '1d;$d' | grep -v '^[[:space:]]*$' | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')" in 'grammar: 0.9.3') IG93=yes ;; esac
  if [ "$IG93" = yes ]; then
    A2=$(printf '%s
' "$PDIFF" | grep '^-' | grep -v '^---' | grep -ciE 'fail-if' || true)
    if git diff --cached --name-only --diff-filter=A | grep -qE '^PRD-HISTORY-[^/]*\.md$'; then A1=0; A2=0; fi
  else
  A2=$(printf '%s
' "$PDIFF" | grep '^-' | grep -v '^---' | grep -c 'Fail-if' || true)
  fi
  AMEND=$(( ${A1:-0} + ${A2:-0} ))
  if [ "$AMEND" -gt 0 ]; then
    mkdir -p .vid
    printf 'failif-amendment n=%s at=%s\n' "$AMEND" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> .vid/metrics-events
    echo "ViD pre-commit: note — $AMEND Fail-if amendment(s) counted (F9: legitimate, and counted)."
  fi
fi

# 7. Touch the law, prove the judge still convicts (§4.2): a law-change
# commit re-runs the court self-tests before it may land.
# v0.9.7.3 (3.6, R6): the memo is a certificate shared by every worktree (below).
# v0.9.5 (3.9): the memo skips only the cases the plugin ships
# (checks/selftest/shipped); every other case — a generated extractor's —
# runs at every law commit. Its key: checks/ as staged, the plugin-root trees
# and files the cases read where present, the tools and git's version, the
# locale; with git 2.32 or later only (the cases read no git configuration
# outside their scratch repositories, which needs GIT_CONFIG_GLOBAL).
if [ "$LAWCOMMIT" = yes ] && [ -f checks/selftest/run.sh ]; then
  BY=selftest   # its refusal is set -e's exit, below
  STKEY=''
  GV=$(git --version 2>/dev/null | sed -n 's/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
  GOK=no
  if [ -n "$GV" ]; then
    if [ "${GV% *}" -gt 2 ] || { [ "${GV% *}" -eq 2 ] && [ "${GV#* }" -ge 32 ]; }; then GOK=yes; fi
  fi
  # v0.9.7.3 (3.6, R6): the certificate — today's key, its store moved to the
  # repository's shared git directory, <absolute git common dir>/vid-selftest/<key>,
  # so every checkout of the repository shares a pass. An entry is a pass only
  # when it reads `pass <key>`: anything else (corrupt, half-written) is a miss.
  CERTD=''
  if [ -n "$MEMOD" ]; then _gcd=$(git rev-parse --git-common-dir 2>/dev/null) && CERTD="$(cd "$_gcd" 2>/dev/null && pwd -P)/vid-selftest" || CERTD=''; fi
  stkey() {   # every line exits on its own failure, as above; prints the key, or nothing
    (
      checks_line || exit 1
      for _r in skills templates hooks RECORDS.md; do
        [ -e "$_r" ] || continue
        for _f in $(find "$_r" -type f | LC_ALL=C sort); do hline "$_f" "$_f" || exit 1; done
      done
      echo "env uname $(uname -sr)"; echo "env $(git --version)"
      for _t in sh awk sed grep sort; do echo "env $_t $(command -v "$_t")"; done
      echo "env LANG=${LANG:-} LC_ALL=${LC_ALL:-} LC_CTYPE=${LC_CTYPE:-}"
    ) > "$TD/st.key.lines" 2>/dev/null && keyof "$TD/st.key.lines" || true
  }
  if [ -n "$CERTD" ] && [ "$GOK" = yes ] && [ -f checks/selftest/shipped ]; then STKEY=$(stkey); fi
  if [ -n "$STKEY" ] && [ "$(cat "$CERTD/$STKEY" 2>/dev/null)" = "pass $STKEY" ]; then
    echo "selftest: ViD's shipped checks unchanged since their last pass — skipped (memo)"
    VID_SELFTEST_UNLISTED=1 sh checks/selftest/run.sh
    F_selftest=memo
  else
    _s=$(date +%s); VID_SELFTEST_RESCUED="$TD/st.rescued" sh checks/selftest/run.sh; F_selftest=$(( $(date +%s) - _s ))
    # published only after a complete pass, through a private file renamed into place, and only while the key's
    # inputs are unchanged and every file under checks/ on disk still equals the index — else the run judged code
    # that was never staged. v0.9.8.1 (R1): never from a run a retry rescued — the next law commit runs the suite again
    if [ -f "$TD/st.rescued" ]; then echo 'selftest: rescued by a retry — no certificate published; the next law commit runs the suite again'; fi
    if [ -n "$STKEY" ] && [ ! -f "$TD/st.rescued" ] && [ "$(stkey)" = "$STKEY" ] && git diff --quiet -- checks 2>/dev/null && [ -z "$(git ls-files --others --exclude-standard -- checks 2>/dev/null)" ]; then
      { mkdir -p "$CERTD" && _ct=$(mktemp "$CERTD/.cert.XXXXXX") && printf 'pass %s\n' "$STKEY" > "$_ct" && mv "$_ct" "$CERTD/$STKEY"; } 2>/dev/null || true
    fi
  fi
fi
exit 0
