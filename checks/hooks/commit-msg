#!/bin/sh
# Purpose: ViD court — reject any commit whose message lacks an explicit
# "Decisions:" line. "Decisions: none — nothing surprising" must be written
# out; bare omission is invalid. Installed via: git config core.hooksPath checks/hooks
# v0.9.2 (3.1c, R1/R5): a commit whose staged diff ADDS a file under
# tests/invariants/ must also carry `Tests-by: test-author <date> <batch>` —
# the test-author pass that wrote it (the surface instrument's batch is
# `surface`); `init` and `builder` are never valid values, because init's
# tests are pass-authored too and the builder never writes a ledger test.
# The trailer is a declaration; the proof of separation is the pass file's
# spawn (the independence header). This hook receives the message file,
# which pre-commit never sees.
# v0.9.6.2 (3.4, R4): each of its two refusals writes `refused
# phase=commit-msg by=decisions|tests-by attempt=<UTC time plus 4 hex>` to
# the run's events (checks/event.sh, so at the run's home). Nothing new is
# enforced.
# v0.26.10.5 (R4): a third refusal, by=stages — a stage membership change citing no owner answer.
# v0.26.10.9 (R1): the spec commit (HEAD carries no
# checks/, as pre-commit tells it) writes no test; a golden set its staged
# INVENTORY.md names in a `golden:` field is the ratified spec's fixture
# (vid-test-inventory §4.6), which the inventory court needs at that commit,
# and needs no Tests-by:. Every other file it adds under tests/invariants/,
# and every later commit, is judged as before.
# 0.26.10.29.3 (R2): a fourth refusal, by=owner — a commit that adds an owner
# ruling carries at least one `Owner:` trailer quoting the owner's words —
# `Owner: "<words>"`, or one per answer, `Owner: A-NNN "<words>"`. A ruling is
# added when the staged PRD.md's effective answer set holds a `human` answer
# whose id and `A:` text (whitespace collapsed) no effective `human` answer of
# HEAD's PRD.md holds — a new id, a changed A:, or a ViD draft restated human
# (during a merge, MERGE_HEAD's PRD.md counts as HEAD's too). Consolidation
# (Q: dropped, AMENDED folded) and rows left as they were add none, and so does
# the first commit of a PRD.md HEAD does not hold (an adopted file's rulings
# were given where it was written).
# serves: both (0.26.10.28.4, M9)
set -eu

MSG_FILE="$1"
# refused <by>: the refusal's event; never changes the exit
refused() {
  _att="$(date -u '+%Y%m%dT%H%M%SZ')-$(od -An -N2 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
  _evh="$(dirname "$0")/../event.sh"
  if [ -f "$_evh" ]; then sh "$_evh" "refused phase=commit-msg by=$1 attempt=$_att" 2>/dev/null || true
  else { mkdir -p .vid && printf 'refused phase=commit-msg by=%s attempt=%s at=%s\n' "$1" "$_att" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> .vid/metrics-events; } 2>/dev/null || true; fi
}

if ! grep -v '^#' "$MSG_FILE" | grep -qE '^Decisions:[[:space:]]*[^[:space:]]'; then
  echo 'ViD commit-msg: rejected — no "Decisions:" line in the commit message.' >&2
  echo '' >&2
  echo 'Every commit states its decisions explicitly. Either:' >&2
  echo '    Decisions: D-012 (chose cursor pagination; enforced: tests/invariants/test_req_004.py)' >&2
  echo '    Decisions: none — nothing surprising' >&2
  echo '' >&2
  echo 'Full commit template (law: CLAUDE.md):' >&2
  echo '    <summary>' >&2
  echo '' >&2
  echo '    REQs: <ids touched, or "none">' >&2
  echo '    Decisions: <entries added, or "none — nothing surprising">' >&2
  echo '    Seams: <ARCHITECTURE.md rows changed, or "none">' >&2
  refused decisions
  exit 1
fi

# v0.26.10.5 (R4): a change to stage membership — STAGES.md's STAGE-, split: or row: lines, or the file created or
# deleted — cites the owner's answer (A-NNN) in its message; checks/stages.sh msg judges it, silent while neither HEAD
# nor the index holds STAGES.md.
_st="$(dirname "$0")/../stages.sh"
if [ -f "$_st" ] && ! sh "$_st" msg "$MSG_FILE"; then
  refused stages
  exit 1
fi

# 0.26.10.29.3 (R2): an owner ruling the commit adds carries the owner's words (the header above). rulings <blob>: the
# effective human answers of that PRD.md, `<id><TAB><A: text, whitespace collapsed>` a line; nothing for no file.
rulings() { git show "$1" 2>/dev/null | sed -n '/^```vid-prd-answers$/,/^```$/p' | grep -v '^```' | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' | awk -F'|' '
  function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
  { id = trim($1); sub(/[ \t]+AMENDED$/, "", id); a = ""
    for (i = 4; i <= NF; i++) { f = trim($i); if (f ~ /^A:/) { sub(/^A:[ \t]*/, "", f); gsub(/[ \t]+/, " ", f); a = f; break } }
    if (!(id in seen)) { o[++n] = id; seen[id] = 1 } T[id] = trim($2); A[id] = a }
  END { for (k = 1; k <= n; k++) if (T[o[k]] == "human") print o[k] "\t" A[o[k]] }' || true; }
if git diff --cached --name-only 2>/dev/null | grep -qxF PRD.md && git rev-parse -q --verify HEAD:PRD.md >/dev/null 2>&1; then
  _old=$(rulings HEAD:PRD.md); if _mh=$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null); then _old="$_old
$(rulings "$_mh:PRD.md")"; fi
  NEWR=$(rulings :PRD.md | OLD="$_old" awk 'BEGIN { n = split(ENVIRON["OLD"], a, "\n"); for (i = 1; i <= n; i++) O[a[i]] = 1 } NF && !($0 in O) { sub(/\t.*/, ""); print }' | paste -sd ' ' -)
  if [ -n "$NEWR" ] && ! grep -v '^#' "$MSG_FILE" | grep -qE '^Owner:[[:space:]]+(A-[0-9]+[[:space:]]+)?("|“).+("|”)'; then
    echo "ViD commit-msg: rejected — this commit adds the owner's ruling(s) $NEWR (a human answer HEAD's PRD.md does not hold) and carries no \"Owner:\" trailer quoting the owner's words." >&2
    echo '' >&2
    echo 'A human answer records what the owner said. Quote it in the message, once for the sitting or once per answer:' >&2
    echo '    Owner: "<the owner'"'"'s words>"' >&2
    echo '    Owner: A-NNN "<the owner'"'"'s words for that answer>"' >&2
    echo 'An answer the owner has not seen is ViD'"'"'s draft: write it model_proposed, and restate it human (an AMENDED row) once the owner says yes.' >&2
    refused owner
    exit 1
  fi
fi

# Tests-by: required when the commit adds a ledger file (v0.9.2 3.1c).
ADDED=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep '^tests/invariants/' || true)
if [ -n "$ADDED" ] && ! git rev-parse -q --verify HEAD:checks >/dev/null 2>&1; then
  GS=$(git show :INVENTORY.md 2>/dev/null | sed -n 's/.*|[[:space:]]*golden:[[:space:]]*\([^|[:space:]]*\).*/\1/p' || true)
  ADDED=$(printf '%s\n' "$ADDED" | GS="$GS" awk 'BEGIN { n = split(ENVIRON["GS"], a, "\n"); for (i = 1; i <= n; i++) G[a[i]] = 1 } NF && !($0 in G)')
fi
if [ -n "$ADDED" ]; then
  TB=$(grep -v '^#' "$MSG_FILE" | sed -n 's/^Tests-by:[[:space:]]*//p' | head -n 1 | sed 's/[[:space:]]*$//')
  if ! printf '%s\n' "$TB" | grep -qE '^test-author [0-9]{4}-[0-9]{2}-[0-9]{2} [^[:space:]]+'; then
    echo 'ViD commit-msg: rejected — this commit adds a ledger file and carries no valid "Tests-by:" trailer:' >&2
    printf '%s\n' "$ADDED" | sed 's/^/    /' >&2
    echo '' >&2
    echo 'A ledger test is written by a test-author pass, never by the builder, the fixer or the init session:' >&2
    echo '    Tests-by: test-author <date> <batch>        (the surface instrument: batch "surface")' >&2
    case "$TB" in
      init*|builder*) echo "\"Tests-by: $TB\" is not a value: init's tests are pass-authored too, and the builder never writes a ledger test (R1)." >&2 ;;
      '') ;;
      *) echo "\"Tests-by: $TB\" is not the shape above." >&2 ;;
    esac
    refused tests-by
    exit 1
  fi
fi
exit 0
